# Copy to .env for local development; load it explicitly with Node or your shell.
JEV_PLAYWRIGHT_PROVIDER_KEY=replace-with-your-key
JEV_PLAYWRIGHT_PROVIDER_URL=https://api.typesafe.ai
JEV_PLAYWRIGHT_ENABLED=true
# JEV_PLAYWRIGHT_DEBUG=true
# BASE_REF=origin/main
# JEV_PLAYWRIGHT_DEFAULT_BRANCH=main
# JEV_PLAYWRIGHT_MODEL=jev-1.13
# JEV_PLAYWRIGHT_INCLUDE=["src/**","e2e/**"]
# JEV_PLAYWRIGHT_EXCLUDE=["src/generated/**"]
# JEV_PLAYWRIGHT_DIFF_WHITESPACE=all
# JEV_PLAYWRIGHT_DIFF_IGNORE_BLANK_LINES=false
# JEV_PLAYWRIGHT_DIFF_CONTEXT_LINES=1
# JEV_PLAYWRIGHT_LIMITS_STATE_AND_QUESTION_TOKENS=32000
# JEV_PLAYWRIGHT_LIMITS_REQUEST_TOKENS=64000
# JEV_PLAYWRIGHT_LIMITS_MAX_REQUESTS=100
# JEV_PLAYWRIGHT_INCLUDE_TEST_SOURCE=true
# JEV_PLAYWRIGHT_MAX_TEST_SOURCE_TOKENS=5000
