{
  "name": "jev-playwright",
  "version": "0.6.0",
  "description": "Jev-powered Playwright test selection",
  "keywords": [
    "playwright",
    "jev",
    "test-selection",
    "e2e"
  ],
  "homepage": "https://github.com/arthurfiorette/jev-playwright#readme",
  "bugs": {
    "url": "https://github.com/arthurfiorette/jev-playwright/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurfiorette/jev-playwright.git"
  },
  "funding": "https://github.com/arthurfiorette/jev-playwright?sponsor=1",
  "license": "MIT",
  "author": "Arthur Fiorette <me@arthur.place>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js",
      "default": "./dist/reporter.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint-ci": "biome ci .",
    "lint-fix": "biome check --write --unsafe .",
    "prepack": "pnpm build",
    "test": "tsx --test test/*.test.ts",
    "test-types": "tsc --noEmit"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "debug": "^4.4.3",
    "js-tokens": "^10.0.0",
    "oxc-parser": "^0.151.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "strip-markdown": "^6.0.0"
  },
  "devDependencies": {
    "@arthurfiorette/biomejs-config": "^2.0.1",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.13.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.62.0"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.16"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=24.16"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
